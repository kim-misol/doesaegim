# ── 클라이언트(빌드 시 번들에 포함됨) ──

# AI 자동완성 스위치. Supabase Edge Function을 쓰면:
VITE_TRANSLATE_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/translate
# (Vercel 등 같은 도메인이면 상대경로도 가능: /api/translate)

# 클라우드 동기화(Supabase). 둘 다 있으면 로그인·동기화 기능이 켜짐.
# 없으면 앱은 로컬(localStorage) 전용으로 그대로 동작.
# anon 키는 공개 키라 노출돼도 안전(데이터 보호는 RLS가 담당).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── 서버 전용 — 절대 커밋 금지. Supabase secrets에만 설정 ──
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ALLOWED_ORIGINS=https://<user>.github.io,http://localhost:5173
